pipeline {
    agent any

    environment {
        IMAGE = "cicd-demo"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -r requirements.txt
                    pytest -v
                '''
            }
        }

        stage('Build Docker image') {
            steps {
                sh "docker build -t ${IMAGE}:${BUILD_NUMBER} -t ${IMAGE}:latest ."
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f cicd-demo || true
                    docker run -d --name cicd-demo -p 5000:5000 ${IMAGE}:latest
                '''
            }
        }

        stage('Smoke test') {
            steps {
                sh '''
                    sleep 3
                    curl -f http://localhost:5000/health
                '''
            }
        }
    }

    post {
        success { echo 'Pipeline OK ✅' }
        failure { echo 'Pipeline en échec ❌' }
    }
}